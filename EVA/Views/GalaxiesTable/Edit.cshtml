@model EVA.Models.GalaxyTable.GalaxiesTableModel

<div class="page-heading">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-12">
                <div class="line-dec"></div>
                <h2>Edit</h2>
                <hr />
                <div class="row text-center">
                    <div class="col-md-4 mx-auto">
                        <form asp-action="Edit">
                            <input type="hidden" asp-for="Id" />

                            <div class="form-group">
                                <label asp-for="Name" class="control-label whitext"></label>
                                <input asp-for="Name" class="form-control white-bg" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Location" class="control-label whitext"></label>
                                <input asp-for="Location" class="form-control white-bg" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Description" class="control-label whitext"></label>
                                <input asp-for="Description" class="form-control white-bg" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Shape" class="control-label whitext"></label>
                                <input asp-for="Shape" class="form-control white-bg" />
                                <span asp-validation-for="Shape" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <input type="submit" value="Save" class="btn btn-primary" />
                                @Html.ActionLink("Cancel", "GalaxiesTableView", null, new { @class = "btn btn-secondary" })
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
